{
  "name": "openeuv",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "validate:evidence": "node scripts/validate-evidence.mjs && node scripts/validate-evidence-reviews.mjs",
    "validate:fab": "node scripts/validate-fab-cases.mjs",
    "audit:integrity": "node scripts/audit-repository-integrity.mjs",
    "audit:integrity:json": "node scripts/audit-repository-integrity.mjs --json",
    "evidence:review-report": "node tools/evidence-review-report.mjs",
    "evidence:review-report:json": "node tools/evidence-review-report.mjs --json",
    "validate:benchmarks": "node scripts/analyze-render-benchmarks.mjs --validate-only",
    "benchmark:analyze": "node scripts/analyze-render-benchmarks.mjs",
    "benchmark:analyze:json": "node scripts/analyze-render-benchmarks.mjs --json",
    "check": "npm run validate:evidence && npm run validate:fab && npm run validate:benchmarks && npm run audit:integrity && npm test && npm run typecheck && npm run build",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy:cloudflare:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.68.0"
  }
}
