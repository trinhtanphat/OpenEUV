{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trinhtanphat/OpenEUV/evidence/optical-constants.schema.json",
  "title": "OpenEUV optical constants dataset",
  "type": "object",
  "required": ["id", "material", "source", "license", "samples"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
    "material": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "doi": { "type": "string" }
      },
      "additionalProperties": false
    },
    "license": { "type": "string", "minLength": 1 },
    "provenanceNote": { "type": "string", "minLength": 1 },
    "wavelengthUnit": { "const": "nm" },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wavelengthNm", "n", "k"],
        "properties": {
          "wavelengthNm": { "type": "number", "exclusiveMinimum": 0 },
          "n": { "type": "number", "exclusiveMinimum": 0 },
          "k": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
